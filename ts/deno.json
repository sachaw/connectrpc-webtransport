{
  "name": "@sachaw/connectrpc-webtransport",
  "version": "0.1.0",
  "license": "MPL-2.0",
  "exports": "./src/mod.ts",
  "imports": {
    "@bufbuild/protobuf": "npm:@bufbuild/protobuf@^2.14.0",
    "@connectrpc/connect": "npm:@connectrpc/connect@^2.1.2",
    "@std/assert": "jsr:@std/assert@^1"
  },
  "unstable": [
    "net"
  ],
  "exclude": [
    "testing/echo_pb.ts"
  ],
  "tasks": {
    "check": "deno check src/mod.ts && deno lint && deno fmt --check",
    "test": "deno test --allow-net --allow-env=ECHO_PORT,ECHO_HASH"
  },
  "publish": {
    "include": [
      "src/mod.ts",
      "src/transport.ts",
      "src/server.ts",
      "src/http1.ts",
      "README.md",
      "deno.json"
    ]
  }
}
